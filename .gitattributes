# Normalisation des fins de ligne
*               text=auto eol=lf
*.bat           text eol=crlf
*.sh            text eol=lf

# Binaires
*.png           binary
*.jpg           binary
*.jpeg          binary
*.gif           binary
*.ico           binary
*.webp          binary
*.woff          binary
*.woff2         binary
*.pdf           binary

# Fichiers exclus des archives (GitHub tarball)
/.github            export-ignore
/.editorconfig      export-ignore
/.gitattributes     export-ignore
/.gitignore         export-ignore
/CLAUDE.md          export-ignore
